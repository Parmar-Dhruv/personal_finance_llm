# Copy to .env and fill in real values. Never commit .env.

# --- Postgres ---
POSTGRES_USER=finsight
POSTGRES_PASSWORD=change_me
POSTGRES_DB=finsight

# --- App ---
ENV=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change_me_to_a_random_64_char_string
ACCESS_TOKEN_EXPIRE_MINUTES=30
BACKEND_CORS_ORIGINS=http://localhost:3000

# --- AI providers ---
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# --- Object storage (SeaweedFS S3 gateway) ---
# Must match seaweedfs/s3-config.json — change both together, or the
# backend will get 403s against the storage container.
OBJECT_STORAGE_BUCKET=finsight-documents
OBJECT_STORAGE_ENDPOINT=http://seaweedfs:8333
OBJECT_STORAGE_ACCESS_KEY=finsight-dev-access-key
OBJECT_STORAGE_SECRET_KEY=finsight-dev-secret-key-change-me
MAX_UPLOAD_SIZE_MB=25
